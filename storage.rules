rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPlaylistJson(fileName) {
      return fileName.matches('^[A-Za-z0-9_-]+\\.json$')
        && request.resource.contentType == 'application/json'
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /users/{uid}/playlists/{fileName} {
      allow read, delete: if isOwner(uid) && fileName.matches('^[A-Za-z0-9_-]+\\.json$');
      allow create, update: if isOwner(uid) && isPlaylistJson(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
